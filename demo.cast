[0.001, "o", "name: demo\r\n\r\ncontainer:\r\n  image: \"alpine/curl\"\r\n  command: [\"sleep\", \"infinity\"]\r\n\r\ndomains:\r\n  allow:\r\n    - api.anthropic.com\r\n    - httpbin.org\r\n\r\nsecret_injection:\r\n  - env: ANTHROPIC_API_KEY\r\n    placeholder: \"{{ANTHROPIC_API_KEY}}\"\r\n    inject_to:\r\n      - api.anthropic.com\r\n\r\nlogging:\r\n  level: info\r\n  allowed_requests: true\r\n"]
