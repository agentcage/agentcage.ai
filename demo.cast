[0.003, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.501, "o", "\r\n\u001b[1;36m"]
[0.001, "o", "           \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\r\n           \u2551 agentcage \u2014 don't let your agent phone home  \u2551\r\n           \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\r\n"]
[0.0, "o", "\u001b[0m\u001b[38;5;243m         Defense-in-depth proxy sandbox for AI agents\u001b[0m\r\n"]
[3.001, "o", "\r\n\u001b[1;36m\u2500\u2500 1. Write a cage config \u2500\u2500\u001b[0m\r\n\r\n"]
[2.501, "o", "\r\n\u001b[38;5;243m  # Define the container image, allowed domains, and secret injection rules\u001b[0m\r\n"]
